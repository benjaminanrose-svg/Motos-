# Copia este archivo como .env y rellena los valores reales
# En Railway estas variables se configuran en la pestaña Variables del servicio

SECRET_KEY=cambia-esto-por-una-clave-segura-generada
DEBUG=False
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1

# Railway provee DATABASE_URL automáticamente al conectar el servicio Postgres
# Usa "Add Variable Reference" → Postgres.DATABASE_URL en el dashboard de Railway
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Variables de base de datos para desarrollo local (alternativa a DATABASE_URL)
DB_NAME=motos_db
DB_USER=motos_user
DB_PASSWORD=motos_pass
DB_HOST=localhost
DB_PORT=5432
